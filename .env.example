# Supabase → Project Settings → API (the legacy "anon" key also works here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used from feature 3 on (server routes only, never exposed to the browser)
ANTHROPIC_API_KEY=
# Max Claude calls per user per day
AI_DAILY_LIMIT=40

# Aleena's time zone, so "today" and streaks roll over at her midnight
APP_TIMEZONE=America/New_York
