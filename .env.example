# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…, or the legacy "anon" key). Safe in the browser:
# RLS blocks it from every table; it's only used for screenshot uploads.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_…, or the legacy "service_role" key). Server only. Never share it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The passcode Aleena types once per device. Use a few words, e.g. "purple otter 2026".
APP_PASSCODE=
# Random string that signs the passcode cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

ANTHROPIC_API_KEY=
# Max tutor messages per day (the tutor is the only feature that calls Claude)
AI_DAILY_LIMIT=40

# Aleena's time zone, so "today" and streaks roll over at her midnight
APP_TIMEZONE=America/New_York
# Name shown on the home screen
STUDENT_NAME=Aleena
